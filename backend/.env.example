# ── Neo4j ────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DB=neo4j

# ── Auth Provider ────────────────────────────────────────────────────
# "local"    → username/password login, local JWT tokens (no external IdP needed)
# "keycloak" → Keycloak OIDC SSO (requires a running Keycloak instance)
AUTH_PROVIDER=local

# ── Keycloak (only when AUTH_PROVIDER=keycloak) ──────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=icp
KEYCLOAK_CLIENT_ID=icp-frontend

# ── Local JWT (only when AUTH_PROVIDER=local) ────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
